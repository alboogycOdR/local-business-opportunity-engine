# Runtime
LBOE_ENV=development
LBOE_LOG_LEVEL=INFO
LBOE_API_HOST=0.0.0.0
LBOE_API_PORT=8000

# PostgreSQL
POSTGRES_DB=lboe
POSTGRES_USER=lboe
POSTGRES_PASSWORD=lboe_dev_only
DATABASE_URL=postgresql+psycopg://lboe:lboe_dev_only@localhost:5432/lboe

# Redis
REDIS_URL=redis://localhost:6379/0

# Feature flags — enable maps only for a deliberate, small discovery run
LBOE_FEATURE_MAPS_SCRAPER=false
LBOE_DISCOVERY_KILL_SWITCH=false
LBOE_MAPS_SCRAPER_URL=http://localhost:8080
LBOE_DISCOVERY_POLL_INTERVAL_SECONDS=2
LBOE_DISCOVERY_MAX_CONCURRENCY=1
LBOE_DISCOVERY_TIMEOUT_SECONDS=300
FEATURE_GOOGLE_PLACES=false
FEATURE_WEBSITE_AUDITOR=false
FEATURE_AI=false
FEATURE_OUTREACH_SEND=false

# Local artifact storage
LBOE_AUDIT_ARTIFACT_ROOT=artifacts/audits
LBOE_AUDIT_MAX_CONCURRENCY=1
LBOE_DEMO_ARTIFACT_ROOT=artifacts

# Future provider keys — leave blank locally until the relevant sprint
GOOGLE_MAPS_API_KEY=
LLM_API_KEY=
