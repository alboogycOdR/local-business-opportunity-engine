+def session() -> Iterator[Session]:
+    """Request-scoped session that is always closed (and its connection returned).
+
+    Returning ``SessionLocal()`` without closing it leaves every UI request's
+    transaction open until garbage collection; under concurrent load the pool
+    (5 + 10 overflow) is exhausted and all database routes fail permanently.
+    """
+    db = SessionLocal()
+    try:
+        yield db
+    finally:
+        db.close()
 
 
